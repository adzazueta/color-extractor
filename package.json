{
  "name": "@adzazueta/color-extractor",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adzazueta/color-extractor.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "node": "./dist/node.js",
      "browser": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./core": "./dist/core.js",
    "./node": "./dist/node.js",
    "./browser": "./dist/browser.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "playwright": "1.63.0",
    "publint": "0.3.25",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "sharp": "^0.35.0"
  },
  "peerDependenciesMeta": {
    "sharp": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "ignore"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
